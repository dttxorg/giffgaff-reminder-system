# 数据库连接串（示例文件不要填写真实凭据）
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# 生产安全配置：部署前全部替换为独立的高熵值
CRON_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_STRONG_12_PLUS_CHARACTER_PASSWORD
ADMIN_TOTP_SECRET=REPLACE_WITH_BASE32_TOTP_SECRET
PUBLIC_BASE_URL=https://baohao.example.com

# 可选：逗号分隔的自建 Bark HTTPS 主机；默认只允许 api.day.app
BARK_ALLOWED_HOSTS=

# 本地 seed 需要样例号码时才设置为 true；生产保持 false
SEED_SAMPLE_DATA=false
