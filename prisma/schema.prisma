// Giffgaff 保号提醒系统 - Prisma Schema
// 部署：Vercel + Neon Postgres (通过 Vercel Storage 集成)
// 本地开发：在 Vercel Dashboard 复制 DATABASE_URL 到 .env

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 号码库（giffgaff sim 卡）
// 一个 sim 绑定 1 个 user(可空 = 孤卡,管理员导入但未绑定用户)
// 每个 user 对应 1 个 sim: 一个兑换码 = 一个 (user, sim) 配对
// 想多张 SIM 卡提醒?用多个兑换码,产生多个账号
model Sim {
  id           Int       @id @default(autoincrement())
  phoneNumber  String    @unique // 完整号，如 07724215611（只存数字）
  // portToken 是公开 URL(/p/[token])用的不可枚举随机串,32 字符 url-safe
  portToken    String?   @unique
  activatedAt  DateTime // 激活日期（保号起算日）
  lastPortedAt DateTime? // 上次保号日期，NULL = 还没保过号
  status       SimStatus @default(active) // active / paused
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // 1:1 反向关系:每个 sim 最多被 1 个 user 拥有
  // User 是关系持有方(Sim 在 userId 上),这里只是 backref
  user      User?         @relation
  reminders ReminderSent[]

  @@index([phoneNumber])
  @@index([activatedAt, lastPortedAt])
}

enum SimStatus {
  active
  paused
}

// 用户档案：一个 user 绑定 1 个 sim,登录用 username + password
// 历史：之前是 User.simId 1:1 + User.simLookupKey(last 6 位) 模糊匹配登录。
//       重构为 username 唯一账号 + 1:1 的 sim 关联。
//       老用户迁移时 username 直接 = sim.phoneNumber,客户无感(继续用原手机号登录)。
//       新用户可以选账号或继续用手机号作账号。
model User {
  id               Int       @id @default(autoincrement())
  // 登录账号：可以是手机号(老用户)或自定义账号(新用户)
  // 唯一索引;case-sensitive 区分(老用户手机号是数字不涉及大小写)
  username         String    @unique
  channel          Channel // serverchan / bark
  channelKey       String // SendKey 或 Bark URL（明文存 V1）
  // 登录密码：scrypt 哈希（null = 旧用户未升级，需管理员重置）
  passwordHash     String?
  // 1:1 - 一个账号对应 1 张 sim 卡
  simId            Int?      @unique
  // 登录限流：连续失败 5 次锁 15 分钟
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sim       Sim?           @relation(fields: [simId], references: [id], onDelete: SetNull)
  reminders ReminderSent[]
  sessions  UserSession[]

  @@index([username])
}

enum Channel {
  serverchan
  bark
  pushplus
  telegram
}

// 发送日志（幂等保证）
model ReminderSent {
  id           Int        @id @default(autoincrement())
  userId       Int
  simId        Int
  dayOffset    Int // 提醒那天的 day_offset（170/178/179/180）
  bucket       Int // 0-indexed bucket
  sentAt       DateTime   @default(now())
  status       SendStatus @default(success)
  errorMessage String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sim  Sim  @relation(fields: [simId], references: [id], onDelete: Cascade)

  @@unique([simId, dayOffset, bucket]) // 同号同日同 bucket 唯一 → 幂等
  @@index([sentAt])
}

enum SendStatus {
  success
  failed
}

// 系统设置（KV 表）
model Setting {
  key       String   @id // 如 "reminder_template"
  value     String // 模板字符串
  updatedAt DateTime @updatedAt
}

// 验证码（保留 model 但已不再使用 - V1 send-code/verify 流程已下线）
model VerificationCode {
  id           Int      @id @default(autoincrement())
  simLookupKey String // 后 6 位（与 simLookupKey 对齐）
  code         String // 6 位数字
  channel      Channel
  channelKey   String // 验证码发送到的目标
  expiresAt    DateTime // 5 分钟过期
  used         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([simLookupKey, code])
}

// 管理员账号（V1 单管理员）
model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String // bcrypt 哈希
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 管理员会话
model AdminSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  expiresAt DateTime // 7 天后过期
}

// 用户会话
model UserSession {
  id        String   @id @default(uuid())
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 卡密：分销/兑换场景
// 空模板卡密，客户兑换时填手机号 + 激活日期 + 推送渠道
// 一次性使用（used=true 后不能再用），永久有效（expiresAt = null）
model CardKey {
  id    Int     @id @default(autoincrement())
  code  String  @unique // XXXX-XXXX-XXXX-XXXX
  notes String? // 管理员备注（档位/批次等）

  used      Boolean   @default(false)
  usedAt    DateTime?
  usedSimId Int?      @unique // 兑换后绑定的 sim（双保险防重复）

  createdAt DateTime  @default(now())
  expiresAt DateTime? // 永久 = null

  @@index([used])
  @@index([createdAt])
}
