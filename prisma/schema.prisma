// Giffgaff 保号提醒系统 - Prisma Schema
// 部署：Vercel + Neon Postgres (通过 Vercel Storage 集成)
// 本地开发：在 Vercel Dashboard 复制 DATABASE_URL 到 .env

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 号码库（giffgaff sim 卡）
// 一个 sim 隶属一个 user(可空 = 孤卡,管理员导入但用户未兑换)。
// 同一个 user 可拥有多个 sim(一个账号管理多张 SIM 卡)。
// 每张 sim 有独立的 channel/channelKey:账号可统一用同一渠道,也可分别设置。
model Sim {
  id           Int       @id @default(autoincrement())
  phoneNumber  String    @unique // 完整号，如 07724215611（只存数字）
  // portToken 是公开 URL(/p/[token])用的不可枚举随机串,32 字符 url-safe
  portToken    String?   @unique
  activatedAt  DateTime // 激活日期（保号起算日）
  lastPortedAt DateTime? // 上次保号日期，NULL = 还没保过号
  status       SimStatus @default(active) // active / paused
  // 每张 sim 独立的推送渠道(账号级可统一,也可各 sim 不同)
  // 首次兑换时为空,引导去 /me/settings 设置
  channel      Channel   @default(serverchan)
  channelKey   String    @default("")
  // 关联 user:1 个 user 可拥有 N 个 sim;sim 端是 FK,user 端是 sims Sim[]
  // onDelete: SetNull - 删 user 时 sim 变孤卡(管理员可在后台看到/清理),不级联删号
  userId       Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  reminders ReminderSent[]

  @@index([phoneNumber])
  @@index([activatedAt, lastPortedAt])
  @@index([userId])
}

enum SimStatus {
  active
  paused
}

// 用户档案:一个 user 拥有 1..N 个 sim,登录用 username + password
// 老用户迁移时 username 直接 = sim.phoneNumber(无感),新用户可以自定义账号
// 用户本身不存 channel/channelKey - 这些都在每张 sim 上(账号级统一 vs 各自不同)
model User {
  id               Int       @id @default(autoincrement())
  // 登录账号：可以是手机号(老用户)或自定义账号(新用户)
  username         String    @unique
  // 登录密码：scrypt 哈希（null = 旧用户未升级，需管理员重置）
  passwordHash     String?
  // 登录限流：连续失败 5 次锁 15 分钟
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // 1:N - 一个账号下可挂多张 sim 卡
  sims      Sim[]          @relation
  reminders ReminderSent[]
  sessions  UserSession[]

  @@index([username])
}

enum Channel {
  serverchan
  bark
  pushplus
  telegram
}

// 发送日志(幂等保证 + 渠道快照便于重发)
model ReminderSent {
  id           Int        @id @default(autoincrement())
  userId       Int
  simId        Int
  dayOffset    Int // 提醒那天的 day_offset（170/178/179/180）
  bucket       Int // 0-indexed bucket
  // 渠道快照:发送时的 channel/channelKey,即使后来改了也不影响历史日志
  channel      Channel
  channelKey   String
  sentAt       DateTime   @default(now())
  status       SendStatus @default(success)
  errorMessage String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sim  Sim  @relation(fields: [simId], references: [id], onDelete: Cascade)

  @@unique([simId, dayOffset, bucket]) // 同号同日同 bucket 唯一 → 幂等
  @@index([simId, sentAt])
  @@index([userId, sentAt])
  @@index([sentAt])
}

enum SendStatus {
  success
  failed
}

// 系统设置（KV 表）
model Setting {
  key       String   @id // 如 "reminder_template"
  value     String // 模板字符串
  updatedAt DateTime @updatedAt
}

// 验证码（保留 model 但已不再使用 - V1 send-code/verify 流程已下线）
model VerificationCode {
  id           Int      @id @default(autoincrement())
  simLookupKey String // 后 6 位（与 simLookupKey 对齐）
  code         String // 6 位数字
  channel      Channel
  channelKey   String // 验证码发送到的目标
  expiresAt    DateTime // 5 分钟过期
  used         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([simLookupKey, code])
}

// 管理员账号（V1 单管理员）
model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String // bcrypt 哈希
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 管理员会话
model AdminSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  expiresAt DateTime // 7 天后过期
}

// 用户会话
model UserSession {
  id        String   @id @default(uuid())
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 卡密：分销/兑换场景
// 空模板卡密，客户兑换时填手机号 + 激活日期 + 推送渠道
// 一次性使用（used=true 后不能再用），永久有效（expiresAt = null）
model CardKey {
  id    Int     @id @default(autoincrement())
  code  String  @unique // XXXX-XXXX-XXXX-XXXX
  notes String? // 管理员备注（档位/批次等）

  used      Boolean   @default(false)
  usedAt    DateTime?
  usedSimId Int?      @unique // 兑换后绑定的 sim（双保险防重复）

  createdAt DateTime  @default(now())
  expiresAt DateTime? // 永久 = null

  @@index([used])
  @@index([createdAt])
}
